# ---------------- QuadBook backend configuration ----------------
# Copy this file to ".env" and edit the values. NEVER commit ".env".

NODE_ENV=development
PORT=4000

# Comma separated list of browser origins allowed to call the API (CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Authentication ---
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10
# max login/register/forgot-password attempts per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=30

# --- MySQL (PRIMARY relational database) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=smart_campus
# Set DB_SSL=true when the hosted MySQL requires a TLS connection
DB_SSL=false

# --- MongoDB (SECONDARY document database: audit + activity + notification history) ---
MONGO_URI=mongodb://127.0.0.1:27017/smart_campus_logs
